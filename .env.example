# Пример переменных окружения для стенда в Docker (docker-compose.yml и связанные
# docker-compose.*.yml). Скопировать в `.env` и заполнить реальными значениями.
#
# JWT_SECRET и DB_PASSWORD — заглушки, в бою и на любом отличном от локального стенде
# заменить на собственные секреты. Остальные значения по умолчанию взяты из
# application.yml сервисов (то, что после `:` внутри `${...}`) — их можно не менять.

# --- База данных (одна на все сервисы, схема своя у каждого) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=savushkin
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT (auth выдаёт, gateway проверяет) ---
JWT_SECRET=change-me
JWT_EXPIRATION_MS=36000000

# --- Kafka (обмен телеметрией и командами runtime <-> scada-gateway) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TAGS_TOPIC=scada.tags
KAFKA_COMMANDS_TOPIC=scada-commands
KAFKA_COMMAND_RESULTS_TOPIC=scada-command-results
KAFKA_COMMAND_TIMEOUT_MS=5000
KAFKA_FETCH_MAX_WAIT_MS=20
KAFKA_FETCH_MIN_BYTES=16384
KAFKA_MAX_POLL_RECORDS=2000

# --- Адреса сервисов друг для друга (для docker-режима — имена контейнеров) ---
AUTH_HOST=localhost
CHANNEL_HOST=localhost
EDITOR_HOST=localhost
EDITOR_PORT=8083
RUNTIME_HOST=localhost

# --- gateway: лимит фрейма WebSocket ---
WS_MAX_FRAME_BYTES=4194304

# --- runtime: пул скриптов GraalVM JS и WebSocket-подключение к фронту ---
RUNTIME_SCRIPT_CONTEXT_POOL=4
RUNTIME_SCRIPT_TIMEOUT_MS=200
RUNTIME_SCRIPT_ONCHANGE_QUEUE=1000
# false — только для локального прогона runtime без gateway (см. application.yml)
RUNTIME_WS_REQUIRE_AUTH=true

# --- scada-gateway (шлюз ПЛК, соседний репозиторий) и PLC-симулятор ---
# Путь на диске до склонированного Z:\Claude\Projects\scada-gateway
SCADA_GATEWAY_PATH=Z:\Claude\Projects\scada-gateway
SCADA_GATEWAY_KAFKA=kafka:19092
SCADA_SIM_ENDPOINT=opc.tcp://scada-simulator:4840
GATEWAY_SEND_BAD_FRAMES=true
