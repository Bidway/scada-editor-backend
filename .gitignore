# Секреты
.env
.env.*
!.env.example

# Gradle / сборка
.gradle/
build/
bin/
out/
!gradle/wrapper/gradle-wrapper.jar

# Node (tools/kafka-sim и пр.)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtualenv (tools/plc-sim-venv) — машинозависимые бинарники, не для git
tools/plc-sim-venv/

# IDE
.idea/
*.iml
.vscode/
.settings/

# OS
.DS_Store
Thumbs.db

# Логи
*.log

# Docker-образы (локально в deliver/images/, не в репозитории)
deliver/images/*.tar.gz


# Документация и рабочие заметки — только локально
docs/
CLAUDE.md

# Локальный инструментарий и его данные: в репозитории не нужны, у каждого свои
.dolt/
*.db
# База задач и журнал взаимодействий — локальные, в git не уходят; конфиг — уходит,
# иначе на другой машине bd не знает ни префикса задач, ни remote (scada-ov3).
.beads/*
!.beads/.gitignore
!.beads/config.yaml
.beads-credential-key
.claude/*
!.claude/skills/
!.claude/learn/
.superpowers/
.codex/
.agents/
.cursor/
