        <mxCell id="arch26-recipe-value-r3c3" parent="arch26-recipe-value-r3" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontSize=11;fontColor=#2f5d2f;" value="true / 77.5 — значение уставки" vertex="1">
          <mxGeometry height="26" width="300" x="360" as="geometry">
            <mxRectangle height="26" width="300" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arch26-er-1" edge="1" parent="1" source="arch26-recipe-value-r1" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;fontSize=10;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#4d4d4d;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" target="arch26-recipe-r0" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arch26-er-2" edge="1" parent="1" source="arch26-event-r1" style="edgeStyle=entityRelationEdgeStyle;rounded=1;html=1;fontSize=10;startArrow=ERmany;startFill=0;endArrow=ERone;endFill=0;strokeColor=#4d4d4d;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" target="bl8s4bZ7Pn-0wrqncFCX-199" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arch26-cmd-edge" edge="1" parent="1" source="bl8s4bZ7Pn-0wrqncFCX-22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;strokeWidth=3;strokeColor=#b85450;endArrow=blockThin;endFill=1;dashed=1;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="bl8s4bZ7Pn-0wrqncFCX-26" value="команда записи тега → топик scada-commands&lt;br&gt;{commandId, idNode, value, dataType} — ждём ack">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="6469" y="2545" />
              <mxPoint x="6865" y="2545" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="layered-arch" name="2. Многослойная архитектура">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2title" value="Многослойная архитектура: как запрос проходит слои внутри каждого микросервиса" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="L0" value="&lt;b&gt;1. Клиент&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Что происходит на слое: формирование запроса и разбор ответа&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4a7ab5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#4a7ab5;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="C0_0" value="Отправляет login/password,&lt;br&gt;сохраняет полученный JWT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a7ab5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="314" y="100" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="C1_0" value="REST для дерева тегов +&lt;br&gt;STOMP-подписка /topic/param/{id}&lt;br&gt;(ws://gateway:8080/ws)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a7ab5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="808" y="100" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="C2_0" value="Рисует мнемосхемы, шлёт дерево&lt;br&gt;компонентов целиком" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a7ab5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1302" y="100" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="C3_0" value="Открывает сессию, слушает WS&lt;br&gt;(ws://gateway:8080/…?token=&amp;lt;JWT&amp;gt;),&lt;br&gt;шлёт ACTION по нажатию кнопки,&lt;br&gt;применяет наборы значений" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a7ab5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1796" y="100" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="&lt;b&gt;2. Слой входа&lt;br&gt;(Gateway)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Аутентификация, маршрутизация, CORS&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#5a8a4a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#5a8a4a;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="254" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="C0_1" value="&lt;i&gt;/api/auth/** проходит&lt;br&gt;без проверки токена&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="314" y="254" width="470" height="130" as="geometry" />
        </mxCell>
        <mxCell id="C1_1" value="Проксирует /api/channel/**,&lt;br&gt;добавляет X-User-Id, X-Username&lt;br&gt;+ &lt;b&gt;/ws/**&lt;/b&gt; — STOMP канала&lt;br&gt;(пока без проверки токена)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="808" y="254" width="470" height="130" as="geometry" />
        </mxCell>
        <mxCell id="C2_1" value="Проксирует /api/editor/**,&lt;br&gt;добавляет X-User-Id, X-Username" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1302" y="254" width="470" height="130" as="geometry" />
        </mxCell>
        <mxCell id="C3_1" value="Проксирует /api/runtime/** и&lt;br&gt;&lt;b&gt;/ws/runtime/**&lt;/b&gt; — WS тоже через gateway,&lt;br&gt;токен в &lt;i&gt;?token=&amp;lt;JWT&amp;gt;&lt;/i&gt;, лимит кадра 4 МБ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1796" y="254" width="470" height="130" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;3. Слой API&lt;br&gt;(controllers)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;HTTP/WS-эндпоинты, валидация запроса, коды ответов&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#c07a20;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#c07a20;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="418" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="C0_2" value="&lt;b&gt;AuthController&lt;/b&gt;&lt;br&gt;POST /register&lt;br&gt;POST /login&lt;br&gt;&lt;br&gt;&lt;i&gt;SecurityConfig, PasswordConfig&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c07a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="314" y="418" width="470" height="190" as="geometry" />
        </mxCell>
        <mxCell id="C1_2" value="&lt;b&gt;NodeController&lt;/b&gt; — дерево узлов, шаблоны&lt;br&gt;&lt;b&gt;ParamController&lt;/b&gt; — параметры (kafka-bindings — legacy, без потребителей)&lt;br&gt;&lt;b&gt;LockController&lt;/b&gt; — захват/снятие блокировок&lt;br&gt;&lt;b&gt;UndoController&lt;/b&gt; — журнал и отмена&lt;br&gt;&lt;i&gt;WebSocketConfig (STOMP), SwaggerConfig,&lt;br&gt;GlobalExceptionHandler&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c07a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="808" y="418" width="470" height="190" as="geometry" />
        </mxCell>
        <mxCell id="C2_2" value="&lt;b&gt;ComponentController&lt;/b&gt; — проекты, сцены, компоненты&lt;br&gt;&lt;b&gt;ComponentPropertyController&lt;/b&gt; — свойства (строки таблиц)&lt;br&gt;&lt;b&gt;RecipeController&lt;/b&gt; — наборы значений, /recipes/{id}/resolved&lt;br&gt;&lt;b&gt;TemplateController&lt;/b&gt; — шаблоны-фейсплейты&lt;br&gt;&lt;b&gt;UndoController&lt;/b&gt; — журнал и отмена&lt;br&gt;&lt;i&gt;SecurityConfig, SwaggerConfig,&lt;br&gt;GlobalExceptionHandler&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c07a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1302" y="418" width="470" height="190" as="geometry" />
        </mxCell>
        <mxCell id="C3_2" value="&lt;b&gt;RuntimeController&lt;/b&gt;&lt;br&gt;POST /api/runtime/sessions • GET …/snapshot&lt;br&gt;DELETE /api/runtime/sessions/{id}&lt;br&gt;&lt;b&gt;RecipeApplyController&lt;/b&gt; — POST /api/runtime/recipes/apply&lt;br&gt;&lt;b&gt;RuntimeWebSocketHandler&lt;/b&gt; — raw WS /ws/runtime/{sessionId}&lt;br&gt;&lt;b&gt;RuntimeHandshakeInterceptor&lt;/b&gt; — личность из X-Username&lt;br&gt;(подпись токена проверил gateway, повторно не разбираем)&lt;br&gt;&lt;i&gt;WebSocketConfig, SecurityConfig, SwaggerConfig&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c07a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1796" y="418" width="470" height="190" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;4. Слой DTO&lt;br&gt;и мапперов&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Преобразование JSON ↔ доменная модель (MapStruct)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b59a20;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#b59a20;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="642" width="250" height="175" as="geometry" />
        </mxCell>
        <mxCell id="C0_3" value="&lt;b&gt;LoginDto, RegisterDto,&lt;br&gt;TokenResponse&lt;/b&gt;&lt;br&gt;&lt;br&gt;маппинг вручную (сервис маленький)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b59a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="314" y="642" width="470" height="175" as="geometry" />
        </mxCell>
        <mxCell id="C1_3" value="&lt;b&gt;DTO:&lt;/b&gt; CreateNodeDto, CreateNodeResponse, NodeDto,&lt;br&gt;NodeResponse, TemplateResponse, CreateParamDto, ParamDto,&lt;br&gt;DescriptionResponse, KafkaBindingDto, KeyValue, WsEvent&lt;br&gt;&lt;b&gt;Mapper:&lt;/b&gt; NodeMapper (MapStruct)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b59a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="808" y="642" width="470" height="175" as="geometry" />
        </mxCell>
        <mxCell id="C2_3" value="&lt;b&gt;DTO:&lt;/b&gt; ComponentCreateDto / ComponentResponseDto,&lt;br&gt;ComponentStateDto, ScriptCreateDto, BindingPayloadDto,&lt;br&gt;EventPayloadDto / EventResponseDto,&lt;br&gt;PropertyCreateDto (+position), ProjectCreateDto, SceneCreateDto,&lt;br&gt;RecipeCreateDto / RecipeValueDto / ResolvedRecipeDto,&lt;br&gt;TemplateCreateDto…&lt;br&gt;&lt;b&gt;Mappers (MapStruct):&lt;/b&gt; ComponentMapper, StateMapper, EventMapper,&lt;br&gt;ScriptMapper, BindingMapper, ComponentPropertyMapper,&lt;br&gt;TemplateComponentMapper…" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b59a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1302" y="642" width="470" height="175" as="geometry" />
        </mxCell>
        <mxCell id="C3_3" value="&lt;b&gt;DTO:&lt;/b&gt; CreateSessionRequest, SessionResponse, TagSnapshot,&lt;br&gt;InboundMessage / OutboundMessage (WS-контракт),&lt;br&gt;TagUpdate, PropertyUpdate&lt;br&gt;ApplyRecipeRequest / ApplyRecipeResult&lt;br&gt;&lt;b&gt;Клиентские DTO editor&#39;а:&lt;/b&gt; EditorComponentDto,&lt;br&gt;EditorPropertyDto, EditorScriptDto, EditorStateDto,&lt;br&gt;EditorBindingDto, EditorEventDto, ResolvedRecipe(Value)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b59a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1796" y="642" width="470" height="175" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="&lt;b&gt;5. Слой бизнес-&lt;br&gt;логики&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Сценарии, транзакции, паттерн Command + undo&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7a5a9a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#7a5a9a;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="851" width="250" height="235" as="geometry" />
        </mxCell>
        <mxCell id="C0_4" value="&lt;b&gt;JwtService&lt;/b&gt; — выпуск и подпись токена HS256&lt;br&gt;&lt;b&gt;BCryptPasswordEncoder&lt;/b&gt; — хэш и сверка пароля&lt;br&gt;&lt;b&gt;SecurityUser&lt;/b&gt; — адаптер UserDetails" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a5a9a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="314" y="851" width="470" height="235" as="geometry" />
        </mxCell>
        <mxCell id="C1_4" value="&lt;b&gt;Сервисы:&lt;/b&gt; NodeServiceImpl, ParamServiceImpl,&lt;br&gt;LockServiceImpl (Redis), UndoService&lt;br&gt;&lt;br&gt;&lt;b&gt;Команды (undo/redo):&lt;/b&gt; CommandManager, CommandBatch,&lt;br&gt;CreateNode / DeleteNode / CreateParam / UpdateParam /&lt;br&gt;DeleteParam Command + соответствующие UndoHandler&#39;ы&lt;br&gt;&lt;i&gt;каждая операция пишет CommandLog: payload, undo_payload,&lt;br&gt;batch_id, sequence&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a5a9a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="808" y="851" width="470" height="235" as="geometry" />
        </mxCell>
        <mxCell id="C2_4" value="&lt;b&gt;Команды:&lt;/b&gt; CreateProject / CreateScene / Create-Update-&lt;br&gt;DeleteComponent, Create-Update-DeleteProperty,&lt;br&gt;Create-Update-DeleteTemplate&lt;br&gt;&lt;b&gt;RecipeServiceImpl&lt;/b&gt; — наборы значений вне undo (не команда)&lt;br&gt;&lt;b&gt;Undo-обработчики:&lt;/b&gt; 11 шт. (по одной на команду)&lt;br&gt;&lt;b&gt;Помощники:&lt;/b&gt; ComponentHierarchyValidator (защита от&lt;br&gt;циклов в дереве), ComponentScriptBindingApplier,&lt;br&gt;TemplateComponentDataApplier&lt;br&gt;&lt;i&gt;optimistic locking через @Version у Component&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a5a9a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1302" y="851" width="470" height="235" as="geometry" />
        </mxCell>
        <mxCell id="C3_4" value="&lt;b&gt;RuntimeSessionService&lt;/b&gt; — жизненный цикл сессии&lt;br&gt;&lt;b&gt;TagSubscriptionIndex&lt;/b&gt; — реверс-индекс tagId → onChange,&lt;br&gt;scriptId → Script&lt;br&gt;&lt;b&gt;TagValueRouter&lt;/b&gt; — маршрут значения по key во все&lt;br&gt;заинтересованные сессии&lt;br&gt;&lt;b&gt;ScriptEngineService&lt;/b&gt; — GraalVM JS (пул Context, таймаут),&lt;br&gt;функция writeTag(имя строки, значение)&lt;br&gt;&lt;b&gt;OnChangeDispatcher&lt;/b&gt; — onChange вне треда Kafka-consumer&#39;а&lt;br&gt;(полосы, сессия закреплена за полосой)&lt;br&gt;&lt;b&gt;TagCommandService / RecipeApplyService&lt;/b&gt; — запись в ПЛК&lt;br&gt;&lt;b&gt;SessionOutboundBuffer + OutboundFlusher&lt;/b&gt; — батч 40 мс,&lt;br&gt;отправка кадров в пуле потоков&lt;br&gt;&lt;b&gt;RuntimeSessionReaper&lt;/b&gt; — уборка брошенных сессий" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a5a9a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1796" y="851" width="470" height="235" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="&lt;b&gt;6. Слой доступа&lt;br&gt;к данным&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Spring Data JPA репозитории, запросы&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#5a8a4a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#5a8a4a;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="250" height="165" as="geometry" />
        </mxCell>
        <mxCell id="C0_5" value="&lt;b&gt;UserRepository&lt;/b&gt;&lt;br&gt;findByLogin(login)&lt;br&gt;existsByLogin(login)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="314" y="1120" width="470" height="165" as="geometry" />
        </mxCell>
        <mxCell id="C1_5" value="&lt;b&gt;NodeRepository, ParamRepository,&lt;br&gt;DescriptionRepository, TemplateRepository,&lt;br&gt;CommandLogRepository&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="808" y="1120" width="470" height="165" as="geometry" />
        </mxCell>
        <mxCell id="C2_5" value="&lt;b&gt;ComponentRepository, ComponentPropertyRepository,&lt;br&gt;ComponentStateRepository, ScriptRepository,&lt;br&gt;BindingRepository, ComponentEventRepository,&lt;br&gt;RecipeRepository, RecipeValueRepository,&lt;br&gt;TemplateFacePlateRepository,&lt;br&gt;TemplateComponent*Repository, CommandLogRepository&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1302" y="1120" width="470" height="165" as="geometry" />
        </mxCell>
        <mxCell id="C3_5" value="&lt;b&gt;Собственной БД нет.&lt;/b&gt;&lt;br&gt;&lt;b&gt;EditorClient&lt;/b&gt; (RestClient) — разовый GET дерева&lt;br&gt;и GET /recipes/{id}/resolved при применении набора&lt;br&gt;&lt;b&gt;TagKafkaConsumer&lt;/b&gt; — постоянный consumer топика тегов&lt;br&gt;(чтение в несколько потоков)&lt;br&gt;&lt;b&gt;CommandProducer&lt;/b&gt; — producer топика команд в ПЛК" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1796" y="1120" width="470" height="165" as="geometry" />
        </mxCell>
        <mxCell id="L6" value="&lt;b&gt;7. Доменная&lt;br&gt;модель&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;JPA-сущности, отражают таблицы схемы&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#b85450;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1319" width="250" height="185" as="geometry" />
        </mxCell>
