          <mxGeometry x="314" y="1319" width="470" height="185" as="geometry" />
        </mxCell>
        <mxCell id="C1_6" value="&lt;b&gt;Node&lt;/b&gt; (id_node — путь через «.»)&lt;br&gt;&lt;b&gt;NodeParam&lt;/b&gt; (id_node, id_type, value)&lt;br&gt;&lt;b&gt;Description&lt;/b&gt; (справочник типов)&lt;br&gt;&lt;b&gt;Template / TemplateParam&lt;/b&gt; (@EmbeddedId)&lt;br&gt;&lt;b&gt;CommandLog&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" vertex="1" parent="1">
