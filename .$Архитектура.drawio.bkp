<mxfile host="Electron" pages="3">
  <diagram id="micro-arch" name="1. Микросервисная архитектура">
    <mxGraphModel dx="1335" dy="2188" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4a7ab5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=18;fontStyle=1;fontColor=#4a7ab5;" value="WEB — фронтенд SCADA" vertex="1">
          <mxGeometry height="260" width="640" x="4821" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a7ab5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;HTTP REST&lt;/b&gt;&lt;br&gt;Все CRUD-запросы редактора и базы каналов.&lt;br&gt;Заголовок &lt;i&gt;Authorization: Bearer &amp;lt;JWT&amp;gt;&lt;/i&gt;&lt;br&gt;Content-Type: application/json&lt;br&gt;Единственный адрес — Gateway :8080" vertex="1">
          <mxGeometry height="160" width="290" x="4841" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-3" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a4f2f;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;WebSocket&lt;/b&gt; — тоже через Gateway :8080&lt;br&gt;&lt;br&gt;Режим &lt;b&gt;редактирования&lt;/b&gt;: подписка на изменения значений параметров.&lt;br&gt;ws://&lt;b&gt;gateway:8080&lt;/b&gt;/ws (STOMP → channel, токен пока не нужен)&lt;br&gt;topic: /topic/param/{paramId}&lt;br&gt;&lt;br&gt;&lt;div&gt;Режим &lt;b&gt;мониторинга&lt;/b&gt;: поток живых значений тегов и свойств.&lt;br&gt;ws://&lt;b&gt;gateway:8080&lt;/b&gt;/ws/runtime/{sessionId}&lt;b&gt;?token=&amp;lt;JWT&amp;gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="290" x="5146" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#5a8a4a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=18;fontStyle=1;fontColor=#5a8a4a;" value="GATEWAY :8080 — единственный вход" vertex="1">
          <mxGeometry height="500" width="334" x="4825" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-5" edge="1" parent="1" source="bl8s4bZ7Pn-0wrqncFCX-6" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2f5d8a;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" target="bl8s4bZ7Pn-0wrqncFCX-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-6" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;JwtAuthenticationFilter&lt;/b&gt;&lt;br&gt;• проверяет подпись HS256 общим секретом &lt;i&gt;JWT_SECRET&lt;/i&gt;&lt;br&gt;• проверяет срок действия&lt;br&gt;• &lt;b&gt;401&lt;/b&gt;, если токена нет / он невалиден&lt;br&gt;• /api/auth/** пропускается без токена&lt;br&gt;• /ws/runtime/** — токен из &lt;i&gt;?token=&amp;lt;JWT&amp;gt;&lt;/i&gt; (браузер не шлёт заголовок)&lt;br&gt;• /ws/** (STOMP канала) пока проксируется без проверки токена" vertex="1">
          <mxGeometry height="160" width="284" x="4844" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-7" edge="1" parent="1" source="bl8s4bZ7Pn-0wrqncFCX-8" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2f5d8a;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" target="bl8s4bZ7Pn-0wrqncFCX-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-8" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;Обогащение запроса&lt;/b&gt;&lt;br&gt;из claims JWT добавляет заголовки:&lt;br&gt;&lt;b&gt;X-User-Id&lt;/b&gt;: 42&lt;br&gt;&lt;b&gt;X-Username&lt;/b&gt;: alice" vertex="1">
          <mxGeometry height="80" width="284" x="4844" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-9" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=1.002;entryY=0.348;entryDx=0;entryDy=0;strokeColor=#2f5d8a;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;entryPerimeter=0;" target="bl8s4bZ7Pn-0wrqncFCX-12">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="4495" y="1669" />
            </Array>
            <mxPoint x="4894.4" y="1669.1799999999998" as="sourcePoint" />
            <mxPoint x="4495" y="1670.81" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-10" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5a8a4a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;Маршрутизация (Path-предикаты)&lt;/b&gt;&lt;br&gt;/api/auth/**&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ auth:8081&lt;br&gt;/api/channel/**&amp;nbsp;→ channel:8082&lt;br&gt;/api/editor/**&amp;nbsp;&amp;nbsp;→ editor:8083&lt;br&gt;/api/runtime/**&amp;nbsp;→ runtime:8085&lt;br&gt;&lt;b&gt;/ws/runtime/**&amp;nbsp;&amp;nbsp;→ runtime:8085&lt;/b&gt; (raw WS)&lt;br&gt;&lt;b&gt;/ws/**&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→ channel:8082&lt;/b&gt; (STOMP, order: 1)&lt;br&gt;&lt;i&gt;лимит WS-кадра поднят до 4 МБ&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="284" x="4844" y="1670" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-11" edge="1" parent="1" source="bl8s4bZ7Pn-0wrqncFCX-12" style="edgeStyle=orthogonalEdgeStyle;shape=connector;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c07a20;strokeWidth=2;dashed=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" target="bl8s4bZ7Pn-0wrqncFCX-178" value="JPA / JDBC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#c07a20;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=17;fontStyle=1;fontColor=#c07a20;" value="AUTH :8081 — аутентификация" vertex="1">
          <mxGeometry height="430" width="400" x="4045" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-13" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c07a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;Функционал&lt;/b&gt;&lt;br&gt;• регистрация пользователя (BCrypt-хэш пароля)&lt;br&gt;• вход и выдача JWT&lt;br&gt;• единственный сервис, доступный без токена" vertex="1">
          <mxGeometry height="130" width="364" x="4063" y="1562" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-14" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c07a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;REST&lt;/b&gt;&lt;br&gt;POST /api/auth/register {login, password} → {token, message}&lt;br&gt;POST /api/auth/login&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{login, password} → {token, message}" vertex="1">
          <mxGeometry height="110" width="364" x="4063" y="1702" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-15" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8ef;strokeColor=#c07a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;Отдаёт наружу JWT&lt;/b&gt; (HS256, TTL 1 ч):&lt;br&gt;{ &quot;sub&quot;: &quot;alice&quot;, &quot;userId&quot;: 42, &quot;iat&quot;: …, &quot;exp&quot;: … }&lt;br&gt;Классы: AuthController, JwtService, UserRepository" vertex="1">
          <mxGeometry height="112" width="364" x="4063" y="1822" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-16" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7a5a9a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=17;fontStyle=1;fontColor=#7a5a9a;" value="CHANNEL :8082 — база каналов" vertex="1">
          <mxGeometry height="450" width="470" x="4365" y="2030" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-17" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a5a9a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;Функционал&lt;/b&gt;&lt;br&gt;• дерево узлов Node (иерархия закодирована в id_node через «.»)&lt;br&gt;• параметры узла NodeParam + справочник типов Description&lt;br&gt;• шаблоны узлов: при создании узла параметры создаются автоматически&lt;br&gt;• блокировки узлов на редактирование (Redis)&lt;br&gt;• журнал команд и undo/redo (batch)" vertex="1">
          <mxGeometry height="150" width="434" x="4383" y="2072" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-18" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a5a9a;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;REST /api/channel&lt;/b&gt;&lt;br&gt;POST /node {idNode, parentId, type} → {batchId, nodeDTO, params[]}&lt;br&gt;DELETE /node/{idNode} → {batchId} (узел + все параметры атомарно)&lt;br&gt;GET /node/fullHierarchy?rootPath= | /node/hierarchy | /node/sites | /node/templates&lt;br&gt;POST /param, DELETE /param/{id}, PATCH /param/update [{key, value}]&lt;br&gt;GET /param/description → справочник типов&lt;br&gt;POST /lock | /unlock [idNode…]&lt;div&gt;GET/POST /undo, /undo/batch/{batchId}&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="434" x="4383" y="2232" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-19" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b59a20;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=17;fontStyle=1;fontColor=#b59a20;" value="EDITOR :8083 — редактор" vertex="1">
          <mxGeometry height="450" width="500" x="5055" y="2030" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-20" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b59a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;Функционал&lt;/b&gt;&lt;br&gt;• дерево Project → Scene → Component → Component&lt;br&gt;• свойства компонента: обычные и &lt;b&gt;TAG&lt;/b&gt; (tag_id = путь узла в channel)&lt;br&gt;• состояния компонента (картинка в jsonb)&lt;br&gt;• &lt;b&gt;события&lt;/b&gt; компонента: onClick, onOpen… (исполняет фронт)&lt;br&gt;• скрипты (по действию) и биндинги (перерисовка на фронте)&lt;br&gt;• таблицы и &lt;b&gt;наборы значений&lt;/b&gt;: recipe / station_params (ключ — имя строки)&lt;br&gt;• шаблоны-фейсплейты (template_faceplate + своё дерево)&lt;br&gt;• журнал команд и undo/redo" vertex="1">
          <mxGeometry height="150" width="464" x="5073" y="2072" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-21" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b59a20;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;REST /api/editor&lt;/b&gt;&lt;br&gt;POST /components/project {name} • GET /components/projects&lt;br&gt;POST /components/scene {name, project_id} • GET /components/scenes?projectId=&lt;br&gt;POST | PUT | DELETE /components — массив ComponentCreateDto (дерево целиком)&lt;br&gt;&lt;b&gt;GET /components/{id}&lt;/b&gt; — дерево проекта (его читает runtime)&lt;br&gt;POST | PUT | DELETE /properties/{id} • CRUD /templates/{id}&lt;br&gt;&lt;b&gt;POST | PUT | DELETE /recipes&lt;/b&gt; • GET /recipes?componentId=&lt;br&gt;&lt;b&gt;GET /recipes/{id}/resolved&lt;/b&gt; — набор + tag_id и value_type строк (читает runtime)&lt;br&gt;GET/POST /undo, /undo/logs?from=&amp;amp;to=, /undo/batch/{batchId}" vertex="1">
          <mxGeometry height="232" width="464" x="5073" y="2232" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-22" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=17;fontStyle=1;fontColor=#b85450;" value="RUNTIME :8085 — монитор" vertex="1">
          <mxGeometry height="450" width="560" x="5965" y="2030" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-23" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;Функционал&lt;/b&gt;&lt;br&gt;• сессия мониторинга проекта: держит дерево и живые значения&lt;br&gt;• подключает TAG-свойства к потоку значений из Kafka (key = путь узла)&lt;br&gt;• исполняет JS-скрипты на бэке (GraalVM): onChange по тегу, Script по ACTION&lt;br&gt;• &lt;b&gt;пишет значения в ПЛК&lt;/b&gt;: writeTag() из скрипта и применение набора&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;значений — командой в топик &lt;b&gt;scada-commands&lt;/b&gt;&lt;br&gt;• &lt;b&gt;не редактирует модель проекта и не участвует в undo&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="524" x="5983" y="2072" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-24" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fontStyle=0;" value="&lt;b&gt;REST /api/runtime&lt;/b&gt;&lt;br&gt;POST /sessions {projectId} → {sessionId, wsPath: &quot;/ws/runtime/{sessionId}&quot;, projectTree}&lt;br&gt;GET /sessions/{id}/snapshot?componentId= → [{tagId, value}] — срез из памяти&lt;br&gt;DELETE /sessions/{id} — снять интерес сессии к тегам&lt;br&gt;&lt;b&gt;POST /recipes/apply&lt;/b&gt; {recipeId, sessionId, projectId} →&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;{total, sent, localApplied, failed, failedRows[], unmatchedRows[]}&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;ответ только после ack брокера, дедлайн 7 с&lt;/i&gt;" vertex="1">
          <mxGeometry height="230" width="524" x="5983" y="2232" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-25" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#7a5a9a;verticalAlign=top;spacingTop=6;fontSize=12;align=center;" value="&lt;b&gt;Redis 7 :6379&lt;/b&gt;&lt;br&gt;&lt;br&gt;Блокировки узлов на время редактирования&lt;br&gt;ключ = idNode → userId, с TTL&lt;br&gt;LockService: POST /lock, /unlock" vertex="1">
          <mxGeometry height="190" width="240" x="3665" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-26" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;spacingTop=6;fontSize=12;align=center;" value="&lt;b&gt;Apache Kafka (KRaft)&lt;/b&gt;&lt;br&gt;:9092 / :19092&lt;br&gt;&lt;br&gt;топик &lt;b&gt;scada.tags&lt;/b&gt; — телеметрия,&lt;br&gt;один на весь проект&lt;br&gt;&lt;b&gt;key = путь узла&lt;/b&gt; (= tag_id)&lt;br&gt;value = JSON-конверт шлюза&lt;br&gt;&lt;br&gt;топик &lt;b&gt;scada-commands&lt;/b&gt; — запись в ПЛК&lt;br&gt;key = путь узла&lt;br&gt;value = {commandId, idNode,&lt;br&gt;value, dataType}" vertex="1">
          <mxGeometry height="290" width="300" x="6715" y="2222" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-27" edge="1" parent="1" source="bl8s4bZ7Pn-0wrqncFCX-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;strokeWidth=2;strokeColor=#2f5d8a;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" target="bl8s4bZ7Pn-0wrqncFCX-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-28" edge="1" parent="1" source="bl8s4bZ7Pn-0wrqncFCX-10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;strokeWidth=2;strokeColor=#2f5d8a;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;exitX=0.385;exitY=0.997;exitDx=0;exitDy=0;exitPerimeter=0;" target="bl8s4bZ7Pn-0wrqncFCX-16" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="4955" y="1710" />
              <mxPoint x="4955" y="2100" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bl8s4bZ7Pn-0wrqncFCX-29" edge="1" parent="1" source="bl8s4bZ7Pn-0wrqncFCX-10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;strokeWidth=2;strokeColor=#2f5d8a;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="bl8s4bZ7Pn-0wrqncFCX-19" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="4988" y="1710" />
              <mxPoint x="4988" y="2100" />
            </Array>
