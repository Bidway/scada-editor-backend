# Общие переменные всех четырёх процессов демо. Копируется в /opt/scada-demo/scada.env,
# два значения CHANGE_ME заменяются (команды — в README, шаг 4).

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=savushkin
DB_USERNAME=scada
DB_PASSWORD=CHANGE_ME

# --- JWT: один секрет у auth (подписывает) и gateway (проверяет) ---
JWT_SECRET=CHANGE_ME

# --- Java-сервисы слушают только localhost: снаружи доступен лишь nginx на 443.
# gateway доверяет заголовку X-Username от фронта, открытый порт сервиса позволил бы
# подделать пользователя в обход проверки токена.
SERVER_ADDRESS=127.0.0.1
SPRING_JPA_SHOW_SQL=false

# editor: флаг «в эксплуатации» некому читать — runtime и Kafka в демо нет.
EDITOR_RUNTIMEPROJECTS_PUBLISHENABLED=false
RECIPES_DIR=/opt/scada-demo/data/recipes

# --- Фронт (node server.js) ---
PORT=3000
HOSTNAME=127.0.0.1
BACKEND_URL=http://127.0.0.1:8080
BACKEND_URL_EDITOR=http://127.0.0.1:8080
